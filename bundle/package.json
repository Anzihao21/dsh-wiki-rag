{
  "name": "dsh-wiki-rag",
  "version": "0.0.16",
  "description": "DeepSeek Harness Wiki 风格知识库 RAG 插件（DSH bundle 形态）",
  "type": "module",
  "engines": {
    "dsh": "~0.2.1-rc.5",
    "node": ">=18"
  },
  "main": "./lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-bundle.cjs",
    "bundle": "node scripts/build-bundle.cjs",
    "watch": "bash scripts/watch.sh"
  },
  "devDependencies": {
    "esbuild": "^0.21.3",
    "jsdom": "^30.1.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "diff": "^5.2.2",
    "dompurify": "^3.4.17",
    "extract-zip": "^2.0.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdf-parse": "^2.4.5",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ]
}
