{
  "name": "dsh-wiki-rag",
  "version": "2.0.17",
  "description": "DeepSeek Harness Wiki 风格知识库 RAG 插件（DSH bundle 形态）",
  "type": "module",
  "engines": {
    "dsh": "~0.2.1-rc.5"
  },
  "main": "./lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-bundle.cjs",
    "bundle": "node scripts/build-bundle.cjs",
    "watch": "bash scripts/watch.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "diff": "^5.2.2",
    "extract-zip": "^2.0.1",
    "better-sqlite3": "^13.0.3"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ]
}
