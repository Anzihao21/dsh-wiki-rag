{
  "name": "dsh-wiki-rag",
  "version": "0.0.8",
  "description": "DeepSeek Harness Wiki风格知识库RAG插件",
  "type": "module",
  "engines": {
    "dsh": "~0.2.1-rc.5",
    "node": ">=18"
  },
  "main": "dist/main/index.js",
  "exports": {
    ".": "./dist/main/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Anzihao21/dsh-wiki-rag.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.main.json && vite build",
    "build:test": "node scripts/build-test.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepare": "husky || true",
    "prepare:git": "git config user.name \"Anzihao21\" && git config user.email \"Anzihao21@users.noreply.github.com\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "diff": "^5.2.0",
    "extract-zip": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.2",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.21.3",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0",
    "xlsx": "^0.18.5"
  }
}
